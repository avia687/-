TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
PORT=3001

# Hour (0-23, Asia/Jerusalem) to send the daily WhatsApp summary. Default: 22
SUMMARY_HOUR=22

# PostgreSQL connection string for persistent income storage.
# On Railway: add a PostgreSQL plugin and it provides DATABASE_URL automatically.
# If unset, income is stored in a local file (server/data/sales.json).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true   # force SSL on/off (auto-detected from sslmode otherwise)
