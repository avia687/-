# --- Database ---
# Dev default is zero-config SQLite (file below). For production switch the
# `provider` in prisma/schema.prisma to "postgresql" and point this at Postgres.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth) ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- AI (optional) ---
# Without a key the deterministic mock AI provider is used automatically.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Integrations (optional, mock providers used when absent) ---
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_ID=""
# STRIPE_SECRET_KEY=""
