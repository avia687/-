# --- Database ---
# Local dev default is zero-config SQLite (file below).
# For production (Vercel), set DATABASE_URL to your Postgres connection string.
# The `vercel-build` script switches the Prisma provider to postgresql
# automatically at build time — no manual schema edit needed.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth) ---
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"
# In production set this to your deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- AI (optional) ---
# Without a key the deterministic mock AI provider is used automatically.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Integrations (optional, mock providers used when absent) ---
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_ID=""
# STRIPE_SECRET_KEY=""
