// BizOS — multi-tenant business operating system.
//
// Dev default is SQLite (zero-config: `npm run setup` works immediately).
// For production, switch `provider` to "postgresql" and point DATABASE_URL at
// a Postgres instance — no model changes required. Note: with SQLite, JSON is
// stored as String; helper columns below use String and are (de)serialized in
// app code, keeping the schema portable across both providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth + platform users
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  image        String?
  isPlatformAdmin Boolean @default(false) // platform-level (SaaS) admin
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships OrganizationMember[]
}

// ---------------------------------------------------------------------------
// Tenant: one Organization = one business = one isolated data boundary.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      BusinessProfile?
  subscription Subscription?
  members      OrganizationMember[]
  customers    Customer[]
  leads        Lead[]
  services     Service[]
  quotes       Quote[]
  jobs         Job[]
  payments     Payment[]
  expenses     Expense[]
  employees    Employee[]
  reviews      Review[]
  automations  Automation[]
  messages     Message[]
  conversations AIConversation[]
  notifications Notification[]
  auditLogs    AuditLog[]
}

// Roles, highest first. Permissions resolved in src/lib/rbac.ts.
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("OWNER") // OWNER | ADMIN | MANAGER | EMPLOYEE
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model BusinessProfile {
  id             String  @id @default(cuid())
  organizationId String  @unique

  businessType   String  @default("generic") // key into the template registry
  name           String
  ownerName      String?
  logo           String? // data URI or URL
  brandColor     String  @default("#4f46e5")

  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  serviceAreas   String? // comma-separated
  hours          String? // JSON string: { mon: "09:00-18:00", ... }
  currency       String  @default("ILS")
  locale         String  @default("he")

  // Per-tenant overrides layered on top of the resolved template.
  terminologyOverrides String? // JSON string: { customer: "מטופל", ... }
  aiInstructions       String?

  onboardedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Core business entities — every row scoped by organizationId.
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  notes          String?
  tags           String?  // comma-separated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads     Lead[]
  quotes    Quote[]
  jobs      Job[]
  payments  Payment[]
  reviews   Review[]

  @@index([organizationId])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  title          String
  contactName    String?
  contactPhone   String?
  source         String?  // where the lead came from
  status         String   @default("new") // new|contacted|quoted|awaiting|won|lost
  value          Float    @default(0)
  probability    Int      @default(50)
  followUpAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String?
  price          Float    @default(0)
  cost           Float    @default(0)
  durationMin    Int      @default(60)
  image          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]

  @@index([organizationId])
}

model Quote {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  publicToken    String   @unique @default(cuid())
  number         Int      @default(1)
  status         String   @default("draft") // draft|sent|approved|rejected
  discount       Float    @default(0)   // absolute amount
  taxRate        Float    @default(0.17)
  taxIncluded    Boolean  @default(false)
  notes          String?
  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  total          Float    @default(0)
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  jobs         Job[]

  @@index([organizationId])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  serviceId String?
  name      String
  quantity  Float   @default(1)
  unitPrice Float   @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model Job {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  quoteId        String?
  employeeId     String?
  title          String
  serviceName    String?
  address        String?
  status         String   @default("scheduled") // scheduled|in_progress|done|cancelled
  price          Float    @default(0)
  startAt        DateTime
  endAt          DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId])
  @@index([startAt])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  jobId          String?
  amount         Float    @default(0)
  method         String   @default("cash") // cash|card|transfer|bit|paypal|other
  status         String   @default("pending") // paid|pending|partial|overdue
  dueAt          DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  category       String   @default("other") // fuel|equipment|materials|payroll|ads|rent|utilities|other
  description    String?
  amount         Float    @default(0)
  receipt        String?  // data URI or URL
  spentAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  role           String   @default("EMPLOYEE") // maps to member role for permissions
  title          String?  // display job title (technician, stylist, ...)
  hourlyRate     Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@index([organizationId])
}

model Review {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  publicToken    String   @unique @default(cuid())
  rating         Int?     // 1..5, null until submitted
  comment        String?
  requestedAt    DateTime @default(now())
  submittedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  key            String   // e.g. job_confirmation, reminder_24h, thank_you, review_request, quote_followup
  enabled        Boolean  @default(false)
  config         String?  // JSON string
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Message {
  id             String   @id @default(cuid())
  organizationId String
  channel        String   @default("whatsapp") // whatsapp|sms|email
  toName         String?
  toAddress      String?
  template       String?
  body           String
  status         String   @default("queued") // queued|sent|failed|delivered
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String   @default("שיחה")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     AIMessage[]

  @@index([organizationId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user|assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // new_customer|quote_approved|payment_received|job_soon|review_new|...
  title          String
  body           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique
  plan           String   @default("free") // free|basic|pro|business
  status         String   @default("active")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entity         String?
  entityId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
