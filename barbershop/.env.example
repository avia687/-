# ─── Booking confirmation emails (optional) ──────────────────────────────
# When these are set, booking confirmations are emailed via SMTP using
# nodemailer. If left empty, the app runs fine and logs the email instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="אדמונד ברברשופ <no-reply@example.com>"

# Public site URL (used for SEO metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://edmond-barbershop.example.com
