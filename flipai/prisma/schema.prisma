// FlipAI database schema
// SQLite by default (zero-config). For production, switch `provider` to
// "postgresql" and point DATABASE_URL at a Postgres instance — no model
// changes required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth-compatible) + user profile
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("user") // "user" | "admin"

  // Onboarding profile
  sellCategory  String? // electronics | vehicles | fashion | furniture | collectibles | other
  sellFrequency String? // occasionally | monthly | frequently
  onboardedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  usage        Usage[]
  products     Product[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  plan               String    @default("free") // free | pro | seller
  status             String    @default("active") // active | canceled | past_due
  provider           String    @default("mock") // mock | stripe
  providerCustomerId String?
  providerSubId      String?
  periodStart        DateTime  @default(now())
  periodEnd          DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id           String @id @default(cuid())
  userId       String
  period       String // "YYYY-MM"
  analysesUsed Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Products & AI output
// ---------------------------------------------------------------------------

model Product {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String? // electronics | vehicles | fashion | furniture | collectibles | other
  condition String? // new | like_new | good | fair | worn
  status    String   @default("draft") // draft | active | sold

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  analysis   Analysis?
  listing    GeneratedListing?
  messages   NegotiationMessage[]

  @@index([userId])
  @@index([userId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  thumbUrl  String?
  width     Int?
  height    Int?
  bytes     Int?
  position  Int      @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Analysis {
  id              String @id @default(cuid())
  productId       String @unique

  estimatedValue  Int
  lowRange        Int
  highRange       Int
  recommendedPrice Int
  quickSalePrice  Int
  maxPrice        Int
  confidence      Int // 0-100
  demandScore     Int // 0-100
  dealScore       Float // 0-10

  // Deal-score breakdown (0-10 each)
  scorePrice      Float @default(0)
  scoreCondition  Float @default(0)
  scoreDemand     Float @default(0)
  scoreResale     Float @default(0)

  source          String @default("ai_estimated") // ai_estimated | market_data
  reasoning       String? // short explanation
  rawJson         String? // full validated AI payload

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GeneratedListing {
  id            String @id @default(cuid())
  productId     String @unique

  title         String
  description   String
  detailsJson   String // key details: condition, model, year, specs, accessories
  strategy      String? // selling strategy text
  startPrice    Int
  expectedPrice Int
  minPrice      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model NegotiationMessage {
  id            String @id @default(cuid())
  productId     String
  buyerMessage  String
  responsesJson String // { friendly, firm, quick }

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
