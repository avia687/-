# ---------------------------------------------------------------------------
# FlipAI environment variables
# Copy this file to `.env` and fill in the values you need.
# The app runs fully with NO external keys (mock AI + simulated checkout).
# Add real keys to switch providers automatically.
# ---------------------------------------------------------------------------

# Database — PostgreSQL. Get a free one at neon.tech or Vercel → Storage.
# Use the POOLED connection string. Example:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-please-generate-a-real-one"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: OpenAI (real product analysis). Omit to use the mock provider. ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- Optional: Google OAuth login. Omit to hide the Google button. ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Optional: Stripe (real billing). Omit to use the simulated checkout. ---
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_SELLER="price_..."

# App base URL (used for Stripe redirects). Defaults to NEXTAUTH_URL.
# APP_URL="http://localhost:3000"
