# Port the server listens on
PORT=4010

# Data mode:
#   (unset / "live") = fetch live data from Polymarket, fall back to demo if unreachable
#   "demo"           = always use built-in demo data (no network calls)
DATA_MODE=

# How long (ms) to cache scan results before re-fetching from Polymarket
CACHE_TTL_MS=60000

# Per-request timeout (ms) for Polymarket API calls
PM_TIMEOUT_MS=15000

# Polymarket API base URLs (override only if Polymarket changes them)
PM_LB_API=https://lb-api.polymarket.com
PM_DATA_API=https://data-api.polymarket.com
PM_PROFILE_URL=https://polymarket.com/profile
