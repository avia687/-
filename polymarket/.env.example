# ------------------------------------------------------------------
# Polymarket Trader Tracker — environment configuration
# Copy to .env and fill in. NEVER commit .env. This system is READ-ONLY:
# it never needs a private key or seed phrase.
# ------------------------------------------------------------------

# HTTP API port
PORT=4000

# SQLite database file (node:sqlite). Use an absolute path in production.
DATABASE_FILE=./data/polymarket.db

# Data source for wallet activity:
#   polymarket  -> live Polymarket public Data/Gamma API (requires outbound network)
#   fixture     -> deterministic local sample data (offline / demo / CI)
DATA_SOURCE=polymarket

# Polymarket public API base URLs (defaults are the official public hosts)
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com

# Monitoring worker
MONITOR_ENABLED=true
# Base polling interval per wallet, in seconds (smart polling adapts around this)
MONITOR_POLL_SECONDS=45
# Max trades to pull per wallet per sync page
MONITOR_PAGE_SIZE=100

# HTTP client behaviour
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=4
# Minimum ms between outbound requests to the same host (client-side rate limit)
HTTP_MIN_INTERVAL_MS=250

# Telegram notifications (optional). Get a token from @BotFather.
# The system NEVER stores these in code — only via env or the settings API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Log level: debug | info | warn | error
LOG_LEVEL=info
