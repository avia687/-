{
  "name": "polymarket-trader-tracker",
  "version": "1.0.0",
  "description": "Production-oriented system to track, analyze and score Polymarket traders from public wallet activity (read-only).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server/index.js",
    "worker": "node --experimental-sqlite server/worker.js",
    "seed": "node --experimental-sqlite server/scripts/seed.js",
    "simulate": "node --experimental-sqlite server/scripts/simulate.js",
    "test": "node --experimental-sqlite --test test/*.test.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
